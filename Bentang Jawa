<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Bentang Jawa — Ride Across Java</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@500;600;700&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #080808;
    color: #f5f5f5;
    font-family: Inter, sans-serif;
    overflow-x: hidden;
}

/* =========================
   NAVIGATION
========================= */

nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: 24px 6%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(
        to bottom,
        rgba(0,0,0,.85),
        transparent
    );
}

.logo {
    font-family: "Space Grotesk", sans-serif;
    font-size: 23px;
    font-weight: 800;
    letter-spacing: -1px;
}

.nav-links {
    display: flex;
    gap: 30px;
}

.nav-links a {
    color: #aaa;
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 2px;
    transition: .3s;
}

.nav-links a:hover {
    color: white;
}

/* =========================
   HERO
========================= */

.hero {
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    padding: 0 7% 90px;
    position: relative;
    overflow: hidden;

    background:
        linear-gradient(
            90deg,
            rgba(0,0,0,.92),
            rgba(0,0,0,.25)
        ),
        linear-gradient(
            0deg,
            #080808,
            transparent 50%
        ),
        url("https://images.unsplash.com/photo-1502744688674-c619d1586c9e?auto=format&fit=crop&w=2000&q=85")
        center/cover;
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
}

.hero-small {
    font-size: 11px;
    letter-spacing: 5px;
    color: #aaa;
    margin-bottom: 20px;
}

.hero h1 {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(70px, 13vw, 180px);
    line-height: .8;
    letter-spacing: -8px;
}

.hero h1 span {
    display: block;
}

.hero-description {
    max-width: 500px;
    color: #aaa;
    margin-top: 35px;
    line-height: 1.7;
}

.hero-btn {
    display: inline-block;
    margin-top: 30px;
    padding: 15px 25px;
    background: white;
    color: black;
    text-decoration: none;
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 2px;
    transition: .3s;
}

.hero-btn:hover {
    transform: translateY(-4px);
}

/* =========================
   GENERAL
========================= */

section {
    padding: 120px 7%;
}

.section-label {
    color: #777;
    font-size: 10px;
    letter-spacing: 4px;
    margin-bottom: 20px;
}

.section-title {
    font-family: "Space Grotesk";
    font-size: clamp(40px, 7vw, 90px);
    line-height: .95;
    letter-spacing: -4px;
}

/* =========================
   STORY
========================= */

.story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
}

.story-text {
    color: #999;
    line-height: 1.9;
    max-width: 600px;
}

.story-text strong {
    color: white;
}

/* =========================
   STATS
========================= */

.stats {
    display: grid;
    grid-template-columns: repeat(2,1fr);
    border-top: 1px solid #222;
    border-bottom: 1px solid #222;
    margin-top: 80px;
}

.stat {
    padding: 45px 0;
    border-right: 1px solid #222;
}

.stat:last-child {
    border-right: none;
    padding-left: 45px;
}

.stat-number {
    font-family: "Space Grotesk";
    font-size: clamp(45px,7vw,90px);
    font-weight: 700;
}

.stat-name {
    color: #777;
    letter-spacing: 3px;
    font-size: 10px;
    margin-top: 8px;
}

/* =========================
   FINISHERS
========================= */

.finishers {
    background: #ededed;
    color: #080808;
}

.finishers .section-label {
    color: #777;
}

.podium {
    margin-top: 70px;
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 2px;
}

.rider {
    min-height: 300px;
    padding: 35px;
    background: #ddd;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: .4s;
}

.rider:hover {
    background: #fff;
    transform: translateY(-8px);
}

.position {
    font-size: 50px;
    font-weight: 900;
    color: #999;
}

.rider:first-child .position {
    color: #111;
}

.rider-name {
    font-family: "Space Grotesk";
    font-size: 26px;
    font-weight: 700;
}

.rider-time {
    color: #777;
    font-size: 11px;
    margin-top: 8px;
}

/* =========================
   MAP
========================= */

.map-wrapper {
    margin-top: 70px;
    border: 1px solid #252525;
    overflow: hidden;
    background: #111;
}

.map-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    transition: .6s;
}

.map-wrapper:hover img {
    transform: scale(1.015);
}

/* =========================
   GAME
========================= */

.game-section {
    background: #050505;
}

.game-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px;
}

.game-description {
    color: #777;
    max-width: 400px;
    line-height: 1.6;
}

.game-box {
    margin-top: 60px;
    position: relative;
    border: 1px solid #282828;
    background: #111;
    overflow: hidden;
}

canvas {
    display: block;
    width: 100%;
    height: auto;
}

.game-ui {
    position: absolute;
    top: 20px;
    left: 25px;
    right: 25px;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
    z-index: 5;
}

.game-stat {
    background: rgba(0,0,0,.55);
    backdrop-filter: blur(10px);
    padding: 12px 17px;
    border: 1px solid #333;
}

.game-stat small {
    display: block;
    color: #888;
    font-size: 8px;
    letter-spacing: 2px;
}

.game-stat strong {
    font-size: 20px;
}

.game-start {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,.48);
    backdrop-filter: blur(3px);
    z-index: 10;
}

.start-card {
    text-align: center;
}

.start-card h3 {
    font-family: "Space Grotesk";
    font-size: 45px;
    letter-spacing: -2px;
}

.start-card p {
    color: #aaa;
    margin: 10px 0 25px;
    font-size: 13px;
}

.start-btn {
    border: none;
    background: white;
    color: black;
    padding: 15px 30px;
    font-weight: 800;
    letter-spacing: 2px;
    cursor: pointer;
}

.mobile-control {
    display: none;
}

/* =========================
   FOOTER
========================= */

footer {
    padding: 80px 7% 40px;
    border-top: 1px solid #222;
}

.footer-logo {
    font-family: "Space Grotesk";
    font-size: clamp(60px,12vw,160px);
    font-weight: 900;
    letter-spacing: -8px;
}

.footer-bottom {
    display: flex;
    justify-content: space-between;
    color: #555;
    font-size: 10px;
    margin-top: 40px;
}

/* =========================
   MOBILE
========================= */

@media(max-width:800px) {

    nav {
        padding: 20px;
    }

    .nav-links {
        display: none;
    }

    section {
        padding: 80px 20px;
    }

    .hero {
        padding: 0 20px 60px;
    }

    .hero h1 {
        font-size: 72px;
        letter-spacing: -4px;
    }

    .story {
        grid-template-columns: 1fr;
        gap: 40px;
    }

    .stats {
        grid-template-columns: 1fr;
    }

    .stat {
        border-right: none;
        border-bottom: 1px solid #222;
    }

    .stat:last-child {
        padding-left: 0;
        border-bottom: none;
    }

    .podium {
        grid-template-columns: 1fr;
    }

    .game-heading {
        display: block;
    }

    .game-description {
        margin-top: 20px;
    }

    .game-box {
        margin-top: 30px;
    }

    .mobile-control {
        display: block;
        position: absolute;
        bottom: 20px;
        right: 20px;
        z-index: 20;
    }

    .jump-btn {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        border: 1px solid #777;
        background: rgba(0,0,0,.7);
        color: white;
        font-weight: 800;
    }

    .footer-bottom {
        display: block;
        line-height: 2;
    }
}
</style>
</head>

