<script>

/* =====================================
   BENTANG JAWA — MINI CYCLING GAME
===================================== */

const canvas =
    document.getElementById("gameCanvas");

const ctx =
    canvas.getContext("2d");

const startScreen =
    document.getElementById("gameStart");

const startBtn =
    document.getElementById("startBtn");

const distanceText =
    document.getElementById("distance");

const scoreText =
    document.getElementById("score");

const bestText =
    document.getElementById("best");

const jumpBtn =
    document.getElementById("jumpBtn");


let gameRunning = false;
let score = 0;
let distance = 0;
let speed = 6;
let spawnTimer = 0;

let bestScore =
    Number(localStorage.getItem(
        "bentangJawaBest"
    )) || 0;

bestText.textContent = bestScore;


/* PLAYER */

const player = {

    x: 130,

    y: 370,

    width: 70,

    height: 50,

    velocityY: 0,

    gravity: .8,

    jumpPower: -15,

    grounded: true

};


/* OBSTACLES */

let obstacles = [];


/* START GAME */

function startGame() {

    gameRunning = true;

    score = 0;

    distance = 0;

    speed = 6;

    spawnTimer = 50;

    obstacles = [];

    player.y = 370;

    player.velocityY = 0;

    player.grounded = true;

    startScreen.style.display = "none";

    requestAnimationFrame(gameLoop);

}


/* JUMP */

function jump() {

    if (!gameRunning) return;

    if (player.grounded) {

        player.velocityY =
            player.jumpPower;

        player.grounded = false;

    }

}


/* KEYBOARD */

document.addEventListener(
    "keydown",
    function(e) {

        if (
            e.code === "Space" ||
            e.code === "ArrowUp"
        ) {

            e.preventDefault();

            if (!gameRunning) {

                startGame();

            } else {

                jump();

            }

        }

    }
);


/* MOBILE */

jumpBtn.addEventListener(
    "touchstart",
    function(e) {

        e.preventDefault();

        if (!gameRunning) {
            startGame();
        }

        jump();

    }
);


startBtn.addEventListener(
    "click",
    startGame
);


/* BACKGROUND */

function drawBackground() {

    const gradient =
        ctx.createLinearGradient(
            0,
            0,
            0,
            canvas.height
        );

    gradient.addColorStop(
        0,
        "#222"
    );

    gradient.addColorStop(
        1,
        "#090909"
    );

    ctx.fillStyle = gradient;

    ctx.fillRect(
        0,
        0,
        canvas.width,
        canvas.height
    );


    /* MOON */

    ctx.fillStyle = "#eee";

    ctx.beginPath();

    ctx.arc(
        1000,
        90,
        42,
        0,
        Math.PI * 2
    );

    ctx.fill();


    /* MOUNTAINS */

    ctx.fillStyle = "#161616";

    ctx.beginPath();

    ctx.moveTo(
        0,
        350
    );

    for (
        let x = 0;
        x <= canvas.width;
        x += 100
    ) {

        const y =
            330 -
            Math.abs(
                Math.sin(x * .009)
            ) * 90;

        ctx.lineTo(
            x,
            y
        );

    }

    ctx.lineTo(
        canvas.width,
        430
    );

    ctx.lineTo(
        0,
        430
    );

    ctx.closePath();

    ctx.fill();


    /* ROAD */

    ctx.fillStyle = "#303030";

    ctx.fillRect(
        0,
        420,
        canvas.width,
        80
    );


    /* ROAD MARKING */

    ctx.strokeStyle = "#aaa";

    ctx.lineWidth = 3;

    ctx.setLineDash([
        50,
        35
    ]);

    ctx.beginPath();

    ctx.moveTo(
        0,
        460
    );

    ctx.lineTo(
        canvas.width,
        460
    );

    ctx.stroke();

    ctx.setLineDash([]);

}


/* PLAYER */

function drawPlayer() {

    ctx.save();

    ctx.translate(
        player.x,
        player.y
    );


    /* SHADOW */

    ctx.fillStyle =
        "rgba(0,0,0,.45)";

    ctx.beginPath();

    ctx.ellipse(
        35,
        50,
        45,
        7,
        0,
        0,
        Math.PI * 2
    );

    ctx.fill();


    /* WHEELS */

    ctx.strokeStyle = "#eee";

    ctx.lineWidth = 4;

    ctx.beginPath();

    ctx.arc(
        15,
        35,
        14,
        0,
        Math.PI * 2
    );

    ctx.stroke();


    ctx.beginPath();

    ctx.arc(
        58,
        35,
        14,
        0,
        Math.PI * 2
    );

    ctx.stroke();


    /* FRAME */

    ctx.strokeStyle = "#fff";

    ctx.lineWidth = 3;

    ctx.beginPath();

    ctx.moveTo(
        15,
        35
    );

    ctx.lineTo(
        30,
        15
    );

    ctx.lineTo(
        45,
        35
    );

    ctx.lineTo(
        15,
        35
    );

    ctx.lineTo(
        58,
        35
    );

    ctx.lineTo(
        30,
        15
    );

    ctx.stroke();


    /* HANDLEBAR */

    ctx.beginPath();

    ctx.moveTo(
        45,
        35
    );

    ctx.lineTo(
        53,
        13
    );

    ctx.lineTo(
        62,
        10
    );

    ctx.stroke();


    /* RIDER HEAD */

    ctx.fillStyle = "#fff";

    ctx.beginPath();

    ctx.arc(
        35,
        3,
        7,
        0,
        Math.PI * 2
    );

    ctx.fill();


    /* RIDER BODY */

    ctx.strokeStyle = "#fff";

    ctx.lineWidth = 4;

    ctx.beginPath();

    ctx.moveTo(
        35,
        10
    );

    ctx.lineTo(
        30,
        24
    );

    ctx.lineTo(
        43,
        28
    );

    ctx.stroke();


    ctx.restore();

}


/* OBSTACLE */

function drawObstacle(obstacle) {

    ctx.fillStyle = "#aaa";

    ctx.beginPath();

    ctx.moveTo(
        obstacle.x,
        obstacle.y +
        obstacle.height
    );

    ctx.lineTo(
        obstacle.x +
        obstacle.width / 2,
        obstacle.y
    );

    ctx.lineTo(
        obstacle.x +
        obstacle.width,
        obstacle.y +
        obstacle.height
    );

    ctx.closePath();

    ctx.fill();

}


/* CREATE OBSTACLE */

function createObstacle() {

    obstacles.push({

        x: canvas.width + 50,

        y: 380,

        width:
            35 +
            Math.random() * 20,

        height:
            40 +
            Math.random() * 20

    });

}


/* COLLISION */

function collision(a,b) {

    return (

        a.x <
        b.x + b.width &&

        a.x + a.width >
        b.x &&

        a.y <
        b.y + b.height &&

        a.y + a.height >
        b.y

    );

}


/* GAME OVER */

function endGame() {

    gameRunning = false;

    if (score > bestScore) {

        bestScore =
            Math.floor(score);

        localStorage.setItem(
            "bentangJawaBest",
            bestScore
        );

    }

    bestText.textContent =
        bestScore;

    startScreen.style.display =
        "flex";

    document.querySelector(
        ".start-card h3"
    ).textContent =
        "RIDE COMPLETE";

    document.querySelector(
        ".start-card p"
    ).textContent =
        "Score: " +
        Math.floor(score) +
        " — coba lagi!";

    startBtn.textContent =
        "RIDE AGAIN";

}


/* GAME LOOP */

function gameLoop() {

    if (!gameRunning) return;


    ctx.clearRect(
        0,
        0,
        canvas.width,
        canvas.height
    );


    drawBackground();


    /* PLAYER PHYSICS */

    player.velocityY +=
        player.gravity;

    player.y +=
        player.velocityY;


    if (player.y >= 370) {

        player.y = 370;

        player.velocityY = 0;

        player.grounded = true;

    }


    /* SPAWN */

    spawnTimer--;

    if (spawnTimer <= 0) {

        createObstacle();

        spawnTimer =
            65 +
            Math.random() * 100;

    }


    /* OBSTACLES */

    for (
        let i = obstacles.length - 1;
        i >= 0;
        i--
    ) {

        const obstacle =
            obstacles[i];

        obstacle.x -= speed;

        drawObstacle(
            obstacle
        );


        const playerBox = {

            x: player.x + 10,

            y: player.y + 8,

            width: 50,

            height: 42

        };


        if (
            collision(
                playerBox,
                obstacle
            )
        ) {

            endGame();

            return;

        }


        if (
            obstacle.x +
            obstacle.width <
            0
        ) {

            obstacles.splice(
                i,
                1
            );

            score += 100;

        }

    }


    drawPlayer();


    /* SCORE */

    distance +=
        speed * .01;

    score += .03;

    speed += .001;


    distanceText.textContent =
        Math.floor(distance) +
        " KM";

    scoreText.textContent =
        Math.floor(score);


    requestAnimationFrame(
        gameLoop
    );

}

</script>

</body>
</html>
